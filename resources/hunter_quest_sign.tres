[resource]
script = ExtResource("1")
sign_title = "Hunter's Challenge"
sign_text = "Brave hunter, a plague of venomous spiders has infested the forest.

We need you to hunt down 5 of these creatures and collect their poison.

Take this vial and fill it with spider venom. It will serve you well in future hunts."
quest_id_to_add = "kill_spiders"
